{"version":2,"transitions":["fade","slideLeft","slideRight","slideUp","zoom","carouselLeft","carouselRight","wipeLeft","wipeRight"],"W":1920,"H":1080,"cw":1920,"ch":1080,"borderColor":"#1A1A1A","total":45,"captions":{"enabled":true,"size":98,"color":"#ffffff","anim":"slideUp","bottomY":1050.6,"lines":[{"text":"মহাস্থানগড়ের কাছে রয়েছে হযরত শাহ সুলতান মাহমুদ বলখী রহমতুল্লাহি\nআলাইহির মাজার শরীফ। দেশের বিভিন্ন স্থান থেকে মানুষ এখানে আসেন।","size":84,"start":0,"length":8.6},{"text":"আর এই মাজারের সঙ্গে জড়িয়ে আছে\nস্থানীয় একটি ঐতিহ্যবাহী খাবার, কাটকাটি।","size":98,"start":8.6,"length":5.4},{"text":"মহাস্থানগড়ে গেলে অনেক দর্শনার্থী এই খাবারের স্বাদ নিতেও\nভুল করেন না। কিন্তু পরশুরামের পতনের গল্প এখানেই শেষ নয়।","size":98,"start":14,"length":7.9},{"text":"কারণ তার পরিবারকে ঘিরেও রয়েছে\nআরেকটি হৃদয়স্পর্শী কিংবদন্তি।","size":98,"start":21.9,"length":4.9},{"text":"পরশুরামের বোন, শীলা দেবী।","size":98,"start":26.8,"length":2.7},{"text":"কথিত আছে, পরশুরামের পরাজয়ের পর\nশীলা দেবী করতোয়া নদীতে আত্মাহুতি দেন।","size":98,"start":29.5,"length":6},{"text":"আজ সেই স্থান শীলা দেবীর ঘাট নামে পরিচিত।","size":98,"start":35.5,"length":3.6},{"text":"ধর্মীয় বিশ্বাসে আজও সেখানে মানুষ\nযায়, নদীতে স্নান করে এবং প্রার্থনা করে।","size":98,"start":39.1,"length":5.9}],"font":{"url":"https://raw.githubusercontent.com/Salimtech353/Reels_Factory/main/File/Kolpona_Unicode.ttf","name":"Kolpona","bold":false}},"segments":[{"start":0,"duration":8.6,"media":{"type":"video","file":"m0.mp4"}},{"start":8.6,"duration":5.4,"media":{"type":"photo","file":"m1.jpg"}},{"start":14,"duration":7.899999999999999,"media":{"type":"video","file":"m2.mp4"}},{"start":21.9,"duration":4.900000000000002,"media":{"type":"photo","file":"m3.jpg"}},{"start":26.8,"duration":2.6999999999999993,"media":{"type":"photo","file":"m4.jpg"}},{"start":29.5,"duration":6,"media":{"type":"photo","file":"m5.jpg"}},{"start":35.5,"duration":3.6000000000000014,"media":{"type":"photo","file":"m6.png"}},{"start":39.1,"duration":5.899999