{"version":2,"transitions":["fade","slideLeft","slideRight","slideUp","zoom","carouselLeft","carouselRight","wipeLeft","wipeRight"],"W":1280,"H":720,"cw":1280,"ch":720,"borderColor":"#1A1A1A","total":52.9,"captions":{"enabled":true,"size":65,"color":"#ffffff","anim":"slideUp","bottomY":700.5,"lines":[{"text":"একটি মসজিদ যার নাম ষাট গম্বুজ\nকিন্তু এর ছাদে রয়েছে ৭৭টি গম্বুজ।","size":65,"start":0,"length":6.4},{"text":"অবিশ্বাস্য মনে হলেও এটাই বাংলাদেশের\nএক ঐতিহাসিক স্থাপনার বিস্ময়।","size":65,"start":6.4,"length":9.8},{"text":"বাগেরহাটে অবস্থিত এই বিখ্যাত মসজিদটি পঞ্চদশ\nশতকে খান জাহান আলীর উদ্যোগে নির্মিত হয়।","size":65,"start":16.2,"length":9.7},{"text":"প্রাচীন ইটের দেয়াল, বিশাল ছাদ আর ৬০টি পাথরের স্তম্ভ,\nপ্রতিটি অংশ যেন বহন করছে শত শত বছরের ইতিহাস।","size":65,"start":25.9,"length":11.2},{"text":"১৯৮৫ সালে বাগেরহাটের ঐতিহাসিক মসজিদ নগরী\nইউনেস্কোর বিশ্ব ঐতিহ্যের তালিকায় স্থান পায়।","size":65,"start":37.1,"length":7.8},{"text":"কয়েক শতাব্দী পেরিয়ে গেলেও ষাট গম্বুজ মসজিদ আজও বাংলার\nমুসলিম স্থাপত্যের গৌরবময় ইতিহাসের সাক্ষী হয়ে দাঁড়িয়ে আছে।","size":62,"start":44.9,"length":8}],"font":{"url":"https://raw.githubusercontent.com/Salimtech353/Reels_Factory/main/File/Kolpona_Unicode.ttf","name":"Kolpona","bold":false}},"segments":[{"start":0,"duration":6.4,"media":{"type":"video","url":"https://videos.pexels.com/video-files/32303571/13776280_640_360_30fps.mp4"}},{"start":6.4,"duration":9.799999999999999,"media":{"type":"video","url":"https://videos.pexels.com/video-files/38232261/16232165_640_360_30fps.mp4"}},{"start":16.2,"duration":9.7,"media":{"type":"video","url":"https://videos.pexels.com/video-files/34241552/14511274_640_360_30fps.mp4"}},{"start":25.9,"duration":11.200000000000003,"media":{"type":"video","url":"https://videos.pexels.com/video-files/36324629/15405206_640_360_50fps.mp4"}},{"start":37.1,"duration":7.799999999999997,"media":{"type":"photo","url":"https://images.pexels.com/photos/37464863/pexels-photo-37464863.jpeg?auto=compress&cs=tinysrgb&h