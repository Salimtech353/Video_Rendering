{"version":2,"transitions":["fade","slideLeft","slideRight","slideUp","zoom","carouselLeft","carouselRight","wipeLeft","wipeRight"],"W":1920,"H":1080,"cw":1920,"ch":1080,"borderColor":"#1A1A1A","total":134.1,"captions":{"enabled":true,"size":98,"color":"#ffffff","anim":"slideUp","bottomY":1050.6,"lines":[{"text":"মহাস্থানগড়ের আরেকটি বিখ্যাত স্থান—গোকুল মেধ।","size":98,"start":0,"length":4.3},{"text":"স্থানীয় লোককথায় এটি পরিচিত\nবেহুলা ও লখিন্দরের বাসরঘর হিসেবে।","size":98,"start":4.3,"length":5.2},{"text":"কাহিনীটি আমরা কমবেশি সবাই জানি।","size":98,"start":9.5,"length":2.5},{"text":"চাঁদ সওদাগরের ছেলে লখিন্দরকে সাপের কামড় থেকে\nরক্ষা করার জন্য বিশেষ নিরাপত্তায় রাখা হয়েছিল।","size":98,"start":12,"length":6.4},{"text":"কিন্তু দেবী মনসার পাঠানো সাপ\nশেষ পর্যন্ত লখিন্দরকে দংশন করে।","size":98,"start":18.4,"length":4.4},{"text":"স্বামীকে ফিরে পাওয়ার আশায় বেহুলার দীর্ঘ যাত্রার কাহিনী পরবর্তীতে\nবাংলা লোকসাহিত্যের অন্যতম জনপ্রিয় কিংবদন্তিতে পরিণত হয়।","size":89,"start":22.8,"length":8.6},{"text":"এছাড়াও এখানে রয়েছে আরও অনেক গুরুত্বপূর্ণ প্রত্নস্থল ।","size":98,"start":31.4,"length":6.9},{"text":"যেমন, বাসু বিহার বা নরপতির ধাপ, গোবিন্দ ভিটা, খোদার পাথর ভিটা, বৈরাগীর ভিটা, স্কন্ধের\nধাপ, টোটারাম পণ্ডিতের ধাপ, বিহার ধাপ, মঙ্গলকোট স্তূপ, তেংড়া বৌদ্ধ স্তূপ এবং ভীমের জঙ্গল।","size":65,"start":38.3,"length":13.2},{"text":"প্রতিটি স্থানের সঙ্গে জড়িয়ে আছে\nপ্রাচীন বাংলার আলাদা ইতিহাস।","size":98,"start":51.5,"length":4.7},{"text":"কিন্তু প্রশ্ন হলো—এত সমৃদ্ধ একটি নগরী কোথায় হারিয়ে গেল?","size":98,"start":56.2,"length":4.8},{"text":"চতুর্দশ শতকের পর মহাস্থানগড় ধীরে\nধীরে তার আগের গুরুত্ব হারাতে থাকে।","size":98,"start":61,"length":5.2},{"text":"জনবসতি কমে যায়।","size":98,"start":66.2,"length":1.7},{"text":"একসময় যে নগরীতে ছিল মানুষের কোলাহল,\nসেখানে পড়ে থাকে শুধু ধ্বংসাবশেষ।","size":98,"start":67.9,"length":5.4},{"text":"এরপর ঊনিশশো আঠাশ সাল থেকে শুরু\nহয় গুরুত্বপূর্ণ প্রত্নতাত্ত্বিক খননকার্য।","size":98,"start":73.3,"length":5.5},{"text":"মাটির স্তর সরাতেই বেরিয়ে আসতে\nথাকে একের পর এক প্রমাণ।","size":98,"start":78.8,"length":3.8},{"text":"প্রাচীন মুদ্রা, মূর্তি, শিলালিপি, পোড়ামাটির ফলক,\nঅলংকার, অস্ত্র এবং নানা ধরনের প্রত্ননিদর্শন।","size":98,"start":82.6,"length":8.8},{"text":"পরবর্তীতে এসব ঐতিহাসিক নিদর্শন সংরক্ষণের\nজন্য প্রতিষ্ঠিত হয় মহাস্থানগড় প্রত্নতাত্ত্বিক জাদুঘর।","size":98,"start":91.4,"length":7},{"text":"আজ মহাস্থানগড়ের ধ্বংসাবশেষের সামনে দাঁড়ালে মনে\nহয়, আমরা যেন শুধু একটি পুরোনো দুর্গ দেখছি না।","size":98,"start":98.4,"length":6.5},{"text":"আমরা দাঁড়িয়ে আছি আড়াই হাজার বছরের ইতিহাসের সামনে।","size":98,"start":104.9,"length":3.9},{"text":"মহাস্থানগড় তাই শুধু একটি প্রত্নতাত্ত্বিক স্থান নয়।","size":98,"start":108.8,"length":3.6},{"text":"এটি বাংলার অতীতের এমন এক দরজা, যার কিছু অংশ\nআমরা খুলতে পেরেছি—আর কিছু অংশ এখনো বন্ধ।","size":98,"start":112.4,"length":6.9},{"text":"হয়তো ভবিষ্যতের কোনো এক প্রত্নতাত্ত্বিক খনন সেই বন্ধ দরজার\nওপাশ থেকে বের করে আনবে আরও একটি বিস্ময়কর গল্প।","size":96,"start":119.3,"length":7.6},{"text":"আর তখন হয়তো আমরা নতুন করে জানতে পারব—","size":98,"start":126.9,"length":3.4},{"text":"আড়াই হাজার বছর আগে এই মাটিতে আসলে কী ঘটেছিল।","size":98,"start":130.3,"length":3.8}],"font":{"url":"https://raw.githubusercontent.com/Salimtech353/Reels_Factory/main/File/Kolpona_Unicode.ttf","name":"Kolpona","bold":false}},"segments":[{"start":0,"duration":4.3,"media":{"type":"photo","file":"m0.jpg"}},{"start":4.3,"duration":5.2,"media":{"type":"photo","file":"m1.jpg"}},{"start":9.5,"duration":2.5,"media":{"type":"video","url":"https://videos.pexels.com/video-files/34672081/14695999_640_360_50fps.mp4"}},{"start":12,"duration":6.399999999999999,"media":{"type":"video","url":"https://videos.pexels.com/video-files/35053370/14849275_640_360_25fps.mp4"}},{"start":18.4,"duration":4.400000000000002,"media":{"type":"video","url":"https://videos.pexels.com/video-files/4408530/4408530-sd_640_360_30fps.mp4"}},{"start":22.8,"duration":8.599999999999998,"media":{"type":"video","file":"m5.mp4"}},{"start":31.4,"duration":6.899999999999999,"media