{"version":2,"transitions":["fade","slideLeft","slideRight","slideUp","zoom","carouselLeft","carouselRight","wipeLeft","wipeRight"],"W":1024,"H":576,"cw":1024,"ch":576,"borderColor":"#1A1A1A","total":128,"captions":{"enabled":true,"size":48,"color":"#2ECC71","anim":"slideUp","bottomY":561.6,"lines":[{"text":"আপনাকে যদি বলি,","size":48,"start":0,"length":3},{"text":"একটি মাত্র গাছ দুই বিঘারও বেশি জমি জুড়ে দাঁড়িয়ে আছে?","size":48,"start":3,"length":5},{"text":"আপনি কি বিশ্বাস করবেন?","size":48,"start":8,"length":2},{"text":"হ্যাঁ, অবিশ্বাস্য হলেও সত্যি!","size":48,"start":10,"length":3},{"text":"ঠাকুরগাঁওয়ে রয়েছে এমনই এক বিশাল\nআমগাছ, যার বয়স ২০০ বছরেরও বেশি।","size":48,"start":13,"length":6},{"text":"এই গাছটির নাম সূর্যপুরী আমগাছ।","size":48,"start":19,"length":3},{"text":"আর এর বিশালত্ব দেখলে আপনার চোখও বিশ্বাস করতে চাইবে না!","size":48,"start":22,"length":4},{"text":"ঠাকুরগাঁও জেলার বালিয়াডাঙ্গী উপজেলার মণ্ডুমালা গ্রামে,\nহরিণমারী এলাকায় দাঁড়িয়ে আছে প্রকৃতির এই বিস্ময়।","size":48,"start":26,"length":7},{"text":"দূর থেকে দেখলে মনে হবে, যেন একসঙ্গে দাঁড়িয়ে আছে অসংখ্য গাছ।","size":48,"start":33,"length":5},{"text":"কিন্তু কাছে গেলেই বুঝবেন, পুরো বিস্তৃতিটা একটি মাত্র আমগাছের!","size":48,"start":38,"length":5},{"text":"আরও অবাক করা বিষয় হলো, গাছটির\nউচ্চতা আনুমানিক ৮০ থেকে ৯০ ফুট।","size":48,"start":43,"length":6},{"text":"এর মূল কাণ্ড থেকে বেরিয়ে এসেছে বিশাল বিশাল উনিশটি মোটা ডাল,","size":48,"start":49,"length":5},{"text":"যেগুলো চারদিকে ছড়িয়ে পড়ে তৈরি\nকরেছে এক অনন্য প্রাকৃতিক ছাউনি।","size":48,"start":54,"length":6},{"text":"কিছু ডাল এতটাই মোটা এবং বিস্তৃত যে, সেগুলোকে\nদূর থেকে আলাদা গাছের কাণ্ড বলেও মনে হয়।","size":48,"start":60,"length":6},{"text":"এবার ভাবুন, প্রায় দুই শতাব্দী ধরে এই গাছ কত ঋতুর পরিবর্তন\nদেখেছে, কত প্রজন্মের মানুষের বেড়ে ওঠার সাক্ষী হয়েছে!","size":48,"start":66,"length":8},{"text":"তবে এই গাছ শুধু বিশাল আকৃতির জন্যই বিখ্যাত নয়।","size":48,"start":74,"length":4},{"text":"এটি সূর্যপুরী জাতের আমগাছ, আর সূর্যপুরী আম ঠাকুরগাঁও\nঅঞ্চলের একটি পরিচিত ও জনপ্রিয় আমের জাত।","size":48,"start":78,"length":7},{"text":"এই আমের সুস্বাদু শাঁস, মনমাতানো সুগন্ধ এবং\nতুলনামূলক ছোট আঁটি এর বিশেষ বৈশিষ্ট্য।","size":48,"start":85,"length":6},{"text":"একবার কল্পনা করুন, প্রকৃতির হাতে তৈরি এই\nবিশাল সবুজ ছাউনির নিচে দাঁড়িয়ে আছেন আপনি,","size":48,"start":91,"length":7},{"text":"আর আপনার মাথার ওপর ছড়িয়ে রয়েছে\nশত শত ডালপালার এক জীবন্ত সাম্রাজ্য!","size":48,"start":98,"length":6},{"text":"তাই ঠাকুরগাঁওয়ের এই সূর্যপুরী আমগাছ শুধু একটি গাছ নয়,","size":48,"start":104,"length":5},{"text":"এটি বাংলার গ্রামীণ প্রকৃতি ও ঐতিহ্যের এক অসাধারণ নিদর্শন।","size":48,"start":109,"length":6},{"text":"একটি গাছ, দুই বিঘারও বেশি বিস্তৃতি,\nআর প্রায় দুই শতাব্দীর ইতিহাস।","size":48,"start":115,"length":6},{"text":"এমন বিস্ময় নিজের চোখে দেখতে চাইলে সূর্যপুরী\nআমগাছ হতে পারে আপনার পরবর্তী ভ্রমণের গন্তব্য।","size":48,"start":121,"length":7}],"font":{"url":"https://raw.githubusercontent.com/Salimtech353/Reels_Factory/main/File/Kolpona_Unicode.ttf","name":"Kolpona","bold":false}},"segments":[{"start":0,"duration":3,"media":{"type":"video","url":"https://videos.pexels.com/video-files/8134976/8134976-sd_640_360_25fps.mp4"}},{"start":3,"duration":5,"media":{"type":"video","url":"https://videos.pexels.com/video-files/11760126/11760126-sd_640_338_30fps.mp4"}},{"start":8,"duration":2,"media":{"type":"video","url":"https://cdn.pixabay.com/video/2015/08/24/545-137110823_small.mp4"}},{"start":10,"duration":3,"media":{"type":"video","url":"https://cdn.pixabay.com/video/2023/04/25/160376-821086361_small.mp4"}},{"start":13,"duration":6,"media":{"type":"video","url":"https://videos.pexels.com/video-files/18650700/18650700-sd_640_360_25fps.mp4"}},{"start":19,"duration":3,"media":{"type":"photo","url":"https://images.pexels.com/photos/7529893/pexels-photo-7529893.jpeg?auto=compress&cs=tinysrgb&h=650&w=940"}},{"start":22,"duration":4,"media":{"type":"video","url":"https://videos.pexels.com/video-files/18650700/18650700-sd_640_360_25fps.mp4"}