{"version":2,"transitions":["fade","slideLeft","slideRight","slideUp","zoom","carouselLeft","carouselRight","wipeLeft","wipeRight"],"W":1280,"H":720,"cw":1280,"ch":720,"borderColor":"#1A1A1A","total":154,"captions":{"enabled":true,"size":55,"color":"#ffffff","anim":"slideUp","bottomY":706.25,"lines":[{"text":"ভাবুন তো, আড়াই হাজার","start":0,"length":2.381},{"text":"বছরের পুরনো একটি নগরী,","start":2.381,"length":2.619},{"text":"যার মাটির নিচে চাপা পড়ে আছে রাজা,","start":5,"length":2.661},{"text":"যুদ্ধ আর অসংখ্য রহস্যের গল্প।","start":7.661,"length":2.339},{"text":"কিন্তু এই নগরীর সবচেয়ে ভয়ঙ্কর","start":10,"length":2.197},{"text":"কাহিনী শুরু হয় একজন রাজার উত্থান","start":12.197,"length":2.424},{"text":"দিয়ে,","start":14.621,"length":0.379},{"text":"আর শেষ হয় এক রহস্যময় সাধকের আগমনে।","start":15,"length":4},{"text":"এটি মহাস্থানগড়, প্রাচীন","start":19,"length":1.84},{"text":"বাংলার অন্যতম প্রাচীন নগরী।","start":20.84,"length":2.16},{"text":"বগুড়ার করতোয়া নদীর তীরে গড়ে ওঠা","start":23,"length":2.523},{"text":"এই নগরী প্রাচীন পুণ্ড্রবর্ধনের","start":25.523,"length":2.442},{"text":"গুরুত্বপূর্ণ রাজধানী ছিল।","start":27.965,"length":2.035},{"text":"মৌর্য, গুপ্ত, পাল ও সেন বিভিন্ন","start":30,"length":2.952},{"text":"সময়েই এই অঞ্চল ছিল গুরুত্বপূর্ণ।","start":32.952,"length":3.048},{"text":"কিন্তু মহাস্থানগড়ের সবচেয়ে","start":36,"length":2.08},{"text":"আলোচিত কাহিনী ইতিহাসের","start":38.08,"length":1.76},{"text":"পাশাপাশি বেঁচে আছে লোককথায়।","start":39.84,"length":2.16},{"text":"কথিত আছে, এই নগরীর রাজপরিবারে","start":42,"length":3.283},{"text":"ছিলেন দুই ভাই— নল ও নীল।","start":45.283,"length":2.717},{"text":"তাদের মধ্যে রাজ্য নিয়ে বিরোধ শুরু","start":48,"length":2.705},{"text":"হলে সেখানে আসেন এক ব্রাহ্মণ।","start":50.705,"length":2.295},{"text":"নিজের মাকে হত্যার পাপ থেকে মুক্তি","start":53,"length":1.684},{"text":"পাওয়ার জন্য তিনি দূর দাক্ষিণাত্য","start":54.684,"length":1.633},{"text":"থেকে এসেছিলেন বলে লোককথায় বলা হয়।","start":56.316,"length":1.684},{"text":"তার হাতে ছিল একটি","start":58,"length":1.889},{"text":"পরশু, অর্থাৎ কুঠার।","start":59.889,"length":2.111},{"text":"নল ও নীলের বিরোধের সুযোগে তিনি শেষ","start":62,"length":2.576},{"text":"পর্যন্ত রাজ্যের ক্ষমতা দখল করেন।","start":64.576,"length":2.424},{"text":"তার আসল নাম ছিল রাম।","start":67,"length":3},{"text":"কিন্তু হাতে থাকা পরশুর কারণে","start":70,"length":1.795},{"text":"ইতিহাস ও লোককথায় তিনি পরিচিত","start":71.795,"length":1.795},{"text":"হয়ে ওঠেন পরশুরাম নামে।","start":73.59,"length":1.41},{"text":"সময় গড়াতে থাকে।","start":75,"length":2},{"text":"কিংবদন্তি অনুযায়ী, পরশুরাম ধীরে","start":77,"length":2.541},{"text":"ধীরে অত্যাচারী শাসকে পরিণত হন।","start":79.541,"length":2.459},{"text":"তার ভয়ে সাধারণ মানুষ ছিল আতঙ্কিত।","start":82,"length":3},{"text":"ঠিক সেই সময় মহাস্থানগড়ের ইতিহাসে","start":85,"length":2.133},{"text":"প্রবেশ করেন এক নতুন ব্যক্তি।","start":87.133,"length":1.867},{"text":"তিনি এসেছিলেন বহু","start":89,"length":1.789},{"text":"দূরের বলখ অঞ্চল থেকে।","start":90.789,"length":2.211},{"text":"তার নাম হযরত শাহ সুলতান","start":93,"length":1.917},{"text":"বলখী রহমাতুল্লাহি আলাইহি।","start":94.917,"length":2.083},{"text":"তার সঙ্গে ছিলেন","start":97,"length":0.882},{"text":"অনুসারীদের একটি দল।","start":97.882,"length":1.118},{"text":"লোককথায় তার মহাস্থানগড়ে আগমনের","start":99,"length":2.542},{"text":"সঙ্গেও রয়েছে এক আশ্চর্য ঘটনা।","start":101.542,"length":2.458},{"text":"বলা হয়, করতোয়া নদী পার হওয়ার","start":104,"length":2.133},{"text":"সময় তিনি মাছের আকৃতির নৌযানে,","start":106.133,"length":2.21},{"text":"আবার কেউ কেউ বলেন তিনি মাছের","start":108.343,"length":2.133},{"text":"পিঠে চড়ে নদী পার হন।","start":110.476,"length":1.524},{"text":"এই কারণেই তার সঙ্গে যুক্ত হয়","start":112,"length":2.5},{"text":"একটি বিশেষ উপাধি— মাহিসওয়ার।","start":114.5,"length":2.5},{"text":"মহাস্থানগড়ে এসে তিনি","start":117,"length":1.395},{"text":"ইসলাম প্রচার শুরু করেন।","start":118.395,"length":1.605},{"text":"কিন্তু একজন নতুন","start":120,"length":1.176},{"text":"ধর্মপ্রচারকের আগমন তৎকালীন","start":121.176,"length":1.912},{"text":"রাজা পরশুরাম কিভাবে নেবেন?","start":123.088,"length":1.912},{"text":"খুব দ্রুতই তাদের","start":125,"length":1.333},{"text":"মধ্যে বিরোধ তৈরি হয়।","start":126.333,"length":1.667},{"text":"একদিকে রাজা পরশুরামের শক্তিশালী","start":128,"length":2.557},{"text":"রাজ্য, অন্যদিকে শাহ সুলতান বলখী","start":130.557,"length":2.557},{"text":"রহমাতুল্লাহি আলাইহি ও তার","start":133.113,"length":2.062},{"text":"অনুসারীরা।","start":135.175,"length":0.825},{"text":"এই বিরোধ শেষ পর্যন্ত এমন এক","start":136,"length":2.274},{"text":"যুদ্ধের রূপ নেয়, যার গল্প আজও","start":138.274,"length":2.442},{"text":"মহাস্থানগড়ের মানুষের মুখে মুখে","start":140.716,"length":2.526},{"text":"ফিরে আসে।","start":143.242,"length":0.758},{"text":"আর সেই যুদ্ধের সঙ্গে","start":144,"length":1.493},{"text":"জড়িয়ে আছে একটি রহস্যময়","start":145.493,"length":1.642},{"text":"কূপের কাহিনী— জিয়ত কুন্ড।","start":147.134,"length":1.866},{"text":"সেই কাহিনীই আমাদের নিয়ে যাবে","start":149,"length":2.188},{"text":"মহাস্থানগড়ের সবচেয়ে নাটকীয়","start":151.188,"length":2.109},{"text":"অধ্যায়ে।","start":153.297,"length":0.703}],"font":{"url":"https://raw.githubusercontent.com/Salimtech353/Reels_Factory/main/File/Kolpona_Unicode.ttf","name":"Kolpona","bold":false}},"segments":[{"start":0,"duration":5,"media":{"type":"photo","file":"m0.jpg"}},{"start":5,"duration":5,"media":{"type":"video","file":"m1.mp4"}},{"start":10,"duration":5,"media":{"type":"photo","file":"m2.jpg"}},{"start":15,"duration":4,"media":{"type":"video","file":"m3.mp4"}},{"start":19,"duration":4,"media":{"type":"video","url":"https://videos.pexels.com/video-files/33357999/14203819_640_360_25fps.mp4"}},{"start":23,"duration":7,"media":{"type":"video","url":"https://videos.pexels.com/video-files/35013696/14833101_640_360_60fps.mp4"}},{"start":30,"duration":6,"media":{"type":"photo","url":"https://images.pexels.com/photos/20317132/pexels-photo-20317132.jpeg?auto=compress&cs=tinysrgb&h=650&w=940"}},{"start"