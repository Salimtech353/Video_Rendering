{"version":2,"transitions":["fade","slideLeft","slideRight","slideUp","zoom","carouselLeft","carouselRight","wipeLeft","wipeRight"],"W":1920,"H":1080,"cw":1920,"ch":1080,"borderColor":"#1A1A1A","total":127.3,"captions":{"enabled":true,"size":98,"color":"#ffffff","anim":"slideUp","bottomY":1050.6,"lines":[{"text":"মহাস্থানগড়ের মাটিতে তখন যুদ্ধের প্রস্তুতি।","size":98,"start":0,"length":3.4},{"text":"একদিকে রাজা পরশুরাম।","size":98,"start":3.4,"length":2.2},{"text":"অন্যদিকে হযরত শাহ সুলতান বলখী রহমাতুল্লাহি আলাইহি।","size":98,"start":5.6,"length":3.4},{"text":"কিন্তু পরশুরামের হাতে ছিল এমন একটি শক্তি, যা তাঁর\nসৈন্যদের যুদ্ধক্ষেত্রে আবার ফিরিয়ে আনতে পারত ।","size":98,"start":9,"length":7.5},{"text":"সেটি ছিল—জিয়ৎ কুণ্ড।","size":98,"start":16.5,"length":2.5},{"text":"লোকবিশ্বাস অনুযায়ী, এই কূপের পানি ছিল অলৌকিক।","size":98,"start":19,"length":4.5},{"text":"যুদ্ধে কোনো সৈন্য আহত হলে তাকে জিয়ৎ কুণ্ডের পানি পান\nকরলে বা সেই পানি ব্যবহার করলে সে আবার সুস্থ হয়ে উঠত।","size":98,"start":23.5,"length":7.6},{"text":"ফলে যতবারই পরশুরামের সৈন্য আহত\nহতো, তারা আবার যুদ্ধক্ষেত্রে ফিরে আসত।","size":98,"start":31.1,"length":5.7},{"text":"শাহ সুলতান রহমাতুল্লাহি আলাইহি\nএই বিষয়টি জানতে পারেন।","size":98,"start":36.8,"length":3.4},{"text":"সুলতান একটি ঈগলের মাধ্যমে মাংসের\nটুকরো জিয়ৎ কুণ্ডের পানিতে ফেলে দেন।","size":98,"start":40.2,"length":8.2},{"text":"এরপর সেই কূপের অলৌকিক ক্ষমতা আর কাজ করেনি। শেষ\nপর্যন্ত ভয়াবহ সংঘর্ষে পরশুরাম পরাজিত এবং নিহত হয়।","size":98,"start":48.4,"length":4.6},{"text":"আর পরশুরামের পতনের সঙ্গে মহাস্থানগড়ের\nইতিহাসে শুরু হয় নতুন একটি অধ্যায়।","size":98,"start":53,"length":5.2},{"text":"আজও এই অঞ্চলে শাহ সুলতানের স্মৃতি অত্যন্ত গুরুত্বপূর্ণ।","size":98,"start":58.2,"length":4},{"text":"মহাস্থানগড়ের কাছে রয়েছে হযরত শাহ সুলতান মাহমুদ\nবলখী রহমাতুল্লাহি আলাইহি এর মাজার শরীফ।","size":98,"start":62.2,"length":8.4},{"text":"দেশের বিভিন্ন স্থান থেকে মানুষ এখানে আসেন। আর এই মাজারের\nসঙ্গে জড়িয়ে আছে স্থানীয় একটি ঐতিহ্যবাহী খাবার —কাটকাটি।","size":93,"start":70.6,"length":5.3},{"text":"মহাস্থানগড়ে গেলে অনেক দর্শনার্থী এই\nখাবারের স্বাদ নিতেও ভুল করেন না।","size":98,"start":75.9,"length":8},{"text":"কিন্তু পরশুরামের পতনের গল্প এখানেই শেষ নয়।","size":98,"start":83.9,"length":4.9},{"text":"কারণ তাঁর পরিবারকে ঘিরেও রয়েছে\nআরেকটি হৃদয়স্পর্শী কিংবদন্তি।","size":98,"start":88.8,"length":2.6},{"text":"পরশুরামের বোন—শিলাদেবী।","size":98,"start":91.4,"length":6},{"text":"কথিত আছে, পরশুরামের পরাজয়ের পর\nশিলাদেবী করতোয়া নদীতে আত্মাহুতি দেন।","size":98,"start":97.4,"length":3.7},{"text":"আজ সেই স্থান —শিলাদেবীর ঘাট নামে পরিচিত। ধর্মীয় বিশ্বাসে\nআজও সেখানে মানুষ যায়, নদীতে স্নান করে এবং প্রার্থনা করে।","size":98,"start":101.1,"length":5.8},{"text":"একজন রাজার উত্থান।","size":98,"start":106.9,"length":2},{"text":"একজন সাধকের আগমন। একটি রহস্যময় কূপ।","size":98,"start":108.9,"length":4.8},{"text":"একটি যুদ্ধ। আর তারপর রাজপরিবারের করুণ পরিণতি।","size":98,"start":113.7,"length":3.5},{"text":"কিন্তু মহাস্থানগড়ের গল্পে আরও একটি কিংবদন্তি আছে, যা\nবাংলা সাহিত্যের সবচেয়ে পরিচিত লোককাহিনিগুলোর একটি।","size":98,"start":117.2,"length":8.1},{"text":"বেহুলা ও লখিন্দর।","size":98,"start":125.3,"length":2}],"font":{"url":"https://raw.githubusercontent.com/Salimtech353/Reels_Factory/main/File/Kolpona_Unicode.ttf","name":"Kolpona","bold":false}},"segments":[{"start":0,"duration":3.4,"media":{"type":"photo","file":"m0.jpg"}},{"start":3.4,"duration":2.1999999999999997,"media":{"type":"photo","file":"m1.jpg"}},{"start":5.6,"duration":3.4000000000000004,"media":{"type":"photo","file":"m2.jpg"}},{"start":9,"duration":7.5,"media":{"type":"photo","file":"m3.jpg"}},{"start":16.5,"duration":2.5,"media":{"type":"video","url":"https://videos.pexels.com/video-files/6034014/6034014-sd_640_360_30fps.mp4"}},{"start":19,"duration":4.5,"media":{"type":"video","url":"https://videos.pexels.com/video-files/7177768/7177768-sd_640_360_24fps.mp4"}},{"start":23.5,"duration":7.600000000000001,"media":{"type":"video","file":"m6.mp4"}},{"start":31.1,"duration":5.699999999999996,"media":{