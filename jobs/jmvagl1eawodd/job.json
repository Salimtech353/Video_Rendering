{"version":2,"transitions":["fade","slideLeft","slideRight","slideUp","zoom","carouselLeft","carouselRight","wipeLeft","wipeRight"],"W":1024,"H":576,"cw":1024,"ch":576,"borderColor":"#1A1A1A","total":122,"captions":{"enabled":true,"size":44,"color":"#ffffff","anim":"slideUp","bottomY":562.8,"lines":[{"text":"আপনাকে যদি বলি,","size":44,"start":0,"length":2},{"text":"একটি মাত্র গাছ দুই বিঘারও বেশি জমি জুড়ে দাঁড়িয়ে আছে?","size":44,"start":2,"length":3},{"text":"আপনি কি বিশ্বাস করবেন?","size":44,"start":5,"length":2},{"text":"হ্যাঁ, অবিশ্বাস্য হলেও সত্যি!","size":44,"start":7,"length":3},{"text":"ঠাকুরগাঁওয়ে রয়েছে এমনই এক বিশাল\nআমগাছ, যার বয়স ২০০ বছরেরও বেশি।","size":44,"start":10,"length":6},{"text":"এই গাছটির নাম সূর্যপুরী আমগাছ।","size":44,"start":16,"length":2},{"text":"আর এর বিশালত্ব দেখলে আপনার\nচোখও বিশ্বাস করতে চাইবে না!","size":44,"start":18,"length":4},{"text":"ঠাকুরগাঁও জেলার বালিয়াডাঙ্গী উপজেলার মণ্ডুমালা গ্রামে,\nহরিণমারী এলাকায় দাঁড়িয়ে আছে প্রকৃতির এই বিস্ময়।","size":44,"start":22,"length":4},{"text":"দূর থেকে দেখলে মনে হবে, যেন\nএকসঙ্গে দাঁড়িয়ে আছে অসংখ্য গাছ।","size":44,"start":26,"length":3},{"text":"কিন্তু কাছে গেলেই বুঝবেন, পুরো\nবিস্তৃতিটা একটি মাত্র আমগাছের!","size":44,"start":29,"length":5},{"text":"আরও অবাক করা বিষয় হলো, গাছটির\nউচ্চতা আনুমানিক ৮০ থেকে ৯০ ফুট।","size":44,"start":34,"length":3},{"text":"এর মূল কাণ্ড থেকে বেরিয়ে এসেছে\nবিশাল বিশাল উনিশটি মোটা ডাল,","size":44,"start":37,"length":3},{"text":"যেগুলো চারদিকে ছড়িয়ে পড়ে তৈরি\nকরেছে এক অনন্য প্রাকৃতিক ছাউনি।","size":44,"start":40,"length":6},{"text":"কিছু ডাল এতটাই মোটা এবং বিস্তৃত যে, সেগুলোকে\nদূর থেকে আলাদা গাছের কাণ্ড বলেও মনে হয়।","size":44,"start":46,"length":10},{"text":"এবার ভাবুন, প্রায় দুই শতাব্দী ধরে এই গাছ কত ঋতুর পরিবর্তন\nদেখেছে, কত প্রজন্মের মানুষের বেড়ে ওঠার সাক্ষী হয়েছে!","size":44,"start":56,"length":6},{"text":"তবে এই গাছ শুধু বিশাল আকৃতির জন্যই বিখ্যাত নয়।","size":44,"start":62,"length":5},{"text":"এটি সূর্যপুরী জাতের আমগাছ, আর সূর্যপুরী আম ঠাকুরগাঁও\nঅঞ্চলের একটি পরিচিত ও জনপ্রিয় আমের জাত।","size":44,"start":67,"length":4},{"text":"এই আমের সুস্বাদু শাঁস, মনমাতানো সুগন্ধ এবং\nতুলনামূলক ছোট আঁটি এর বিশেষ বৈশিষ্ট্য।","size":44,"start":71,"length":3},{"text":"একবার কল্পনা করুন, প্রকৃতির হাতে তৈরি এই\nবিশাল সবুজ ছাউনির নিচে দাঁড়িয়ে আছেন আপনি,","size":44,"start":74,"length":8},{"text":"আর আপনার মাথার ওপর ছড়িয়ে রয়েছে\nশত শত ডালপালার এক জীবন্ত সাম্রাজ্য!","size":44,"start":82,"length":7},{"text":"তাই ঠাকুরগাঁওয়ের এই সূর্যপুরী আমগাছ শুধু একটি গাছ নয়,","size":44,"start":89,"length":11},{"text":"এটি বাংলার গ্রামীণ প্রকৃতি ও\nঐতিহ্যের এক অসাধারণ নিদর্শন।","size":44,"start":100,"length":9},{"text":"একটি গাছ, দুই বিঘারও বেশি বিস্তৃতি,\nআর প্রায় দুই শতাব্দীর ইতিহাস।","size":44,"start":109,"length":1},{"text":"এমন বিস্ময় নিজের চোখে দেখতে চাইলে সূর্যপুরী\nআমগাছ হতে পারে আপনার পরবর্তী ভ্রমণের গন্তব্য।","size":44,"start":110,"length":12}],"font":{"url":"https://raw.githubusercontent.com/google/fonts/main/ofl/hindsiliguri/HindSiliguri-Regular.ttf","name":"Hind Siliguri","bold":false}},"segments":[{"start":0,"duration":2,"media":{"type":"video","url":"https://videos.pexels.com/video-files/4540151/4540151-sd_640_360_30fps.mp4"}},{"start":2,"duration":3,"media":{"type":"video","url":"https://videos.pexels.com/video-files/31369206/13385950_640_360_60fps.mp4"}},{"start":5,"duration":2,"media":{"type":"video","url":"https://videos.pexels.com/video-files/7327410/7327410-sd_640_360_25fps.mp4"}},{"start":7,"duration":3,"media":{"type":"video","url":"https://videos.pexels.com/video-files/8524498/8524498-sd_640_338_25fps.mp4"}},{"start":10,"duration":6,"media":{"type":"video","url":"https://videos.pexels.com/video-files/7593181/7593181-sd_640_310_30fps.mp4"}},{"start":16,"duration":2,"media":{"type":"video","url":"https://videos.pexels.com/video-files/2239153/2239153-sd_640_360_24fps.mp4"}},{"start":18,"duration":4,"media":{"type":"video","url":"https://videos.pexels.com/video-files/34223313/14504496_640_360_25fps.mp4"}},{"sta