{"version":2,"transitions":["fade","slideLeft","slideRight","slideUp","zoom","carouselLeft","carouselRight","wipeLeft","wipeRight"],"W":1920,"H":1080,"cw":1920,"ch":1080,"borderColor":"#1A1A1A","total":163.9,"captions":{"enabled":true,"size":98,"color":"#ffffff","anim":"slideUp","bottomY":1050.6,"lines":[{"text":"ভাবুন তো আড়াই হাজার বছরের পুরনো একটি নগরী, যার মাটির\nনিচে চাপা পড়ে আছে রাজা, যুদ্ধ, আর অসংখ্য রহস্যের গল্প।","size":98,"start":0,"length":9.6},{"text":"কিন্তু এই নগরীর সবচেয়ে ভয়ঙ্কর কাহিনী শুরু হয় একজন রাজার\nউত্থান দিয়ে, আর শেষ হয় এক রহস্যময় সাধকের আগমনে।","size":96,"start":9.6,"length":8.4},{"text":"ইতিহাসের আড়ালে লুকিয়ে থাকা এমনই সব বিস্ময়কর কাহিনী জানতে\nTime Trails চ্যানেলটি সাবস্ক্রাইব করে আমাদের সঙ্গে থাকুন।","size":88,"start":18,"length":6.8},{"text":"এবার চলুন, ফিরে যাই আড়াই\nহাজার বছর আগের প্রাচীন বাংলায়।","size":98,"start":24.8,"length":4.4},{"text":"এটি মহাস্থানগড়, প্রাচীন বাংলার অন্যতম প্রাচীন নগরী।","size":98,"start":29.2,"length":9.2},{"text":"বগুড়ার করতোয়া নদীর তীরে গড়ে ওঠা এই\nনগরী প্রাচীন পুণ্ড্রবর্ধনের গুরুত্বপূর্ণ রাজধানী ছিল।","size":98,"start":38.4,"length":6.7},{"text":"মৌর্য, গুপ্ত, পাল ও সেন বিভিন্ন\nসময়ই এই অঞ্চল ছিল গুরুত্বপূর্ণ।","size":98,"start":45.1,"length":5.8},{"text":"কিন্তু মহাস্থানগড়ের সবচেয়ে আলোচিত কাহিনী\nইতিহাসের পাশাপাশি বেঁচে আছে লোককথায়।","size":98,"start":50.9,"length":5.7},{"text":"কথিত আছে, এই নগরীর রাজপরিবারে\nছিলেন দুই ভাই—নল ও নীল।","size":98,"start":56.6,"length":5.2},{"text":"তাদের মধ্যে রাজ্য নিয়ে বিরোধ শুরু\nহলে সেখানে আসেন এক ব্রাহ্মণ।","size":98,"start":61.8,"length":4.1},{"text":"নিজের মাকে হত্যার পাপ থেকে মুক্তি পাওয়ার জন্য তিনি\nদূর দাক্ষিণাত্য থেকে এসেছিলেন বলে লোককথায় বলা হয়।","size":98,"start":65.9,"length":7},{"text":"তার হাতে ছিল একটি পরশু, অর্থাৎ কুঠার।","size":98,"start":72.9,"length":2.4},{"text":"নল ও নীলের বিরোধের সুযোগে তিনি শেষ পর্যন্ত রাজ্যের\nক্ষমতা দখল করেন। তার আসল নাম ছিল রাম।","size":98,"start":75.3,"length":6.3},{"text":"কিন্তু হাতে থাকা পরশুর কারণে ইতিহাস ও\nলোককথায় তিনি পরিচিত হয়ে ওঠেন পরশুরাম নামে।","size":98,"start":81.6,"length":8.6},{"text":"সময় গড়াতে থাকে।","size":98,"start":90.2,"length":4.5},{"text":"কিংবদন্তি অনুযায়ী, পরশুরাম ধীরে ধীরে অত্যাচারী শাসকে\nপরিণত হন। তার ভয়ে সাধারণ মানুষ ছিল আতঙ্কিত।","size":98,"start":94.7,"length":5},{"text":"ঠিক সেই সময় মহাস্থানগড়ের ইতিহাসে\nপ্রবেশ করেন এক নতুন ব্যক্তি।","size":98,"start":99.7,"length":2.8},{"text":"তিনি এসেছিলেন বহু দূরের বলখ অঞ্চল থেকে। তার\nনাম হযরত শাহ সুলতান বলখী রহমতুল্লাহি আলাইহি।","size":98,"start":102.5,"length":7.1},{"text":"তার সঙ্গে ছিলেন অনুসারীদের একটি দল।","size":98,"start":109.6,"length":3.5},{"text":"লোককথায় তার মহাস্থানগড়ে আগমনের\nসঙ্গেও রয়েছে এক আশ্চর্য ঘটনা।","size":98,"start":113.1,"length":2.3},{"text":"বলা হয়, করতোয়া নদী পার হওয়ার সময় তিনি মাছের আকৃতির\nনৌযানে, আবার কেউ কেউ বলেন তিনি মাছের পিঠে চড়ে নদী পার হন।","size":91,"start":115.4,"length":9.1},{"text":"এই কারণেই তার সঙ্গে যুক্ত হয়\nএকটি বিশেষ উপাধি—মাহিসওয়ার।","size":98,"start":124.5,"length":3.7},{"text":"মহাস্থানগড়ে এসে তিনি ইসলাম প্রচার শুরু করেন।","size":98,"start":128.2,"length":4.6},{"text":"কিন্তু একজন নতুন ধর্মপ্রচারকের আগমন\nতৎকালীন রাজা পরশুরাম কীভাবে নেবেন?","size":98,"start":132.8,"length":3.5},{"text":"খুব দ্রুতই তাদের মধ্যে বিরোধ তৈরি হয়। একদিকে রাজা পরশুরামের শক্তিশালী\nরাজ্য, অন্যদিকে শাহ সুলতান বলখী রহমতুল্লাহি আলাইহি ও তার অনুসারীরা।","size":78,"start":136.3,"length":14.3},{"text":"এই বিরোধ শেষ পর্যন্ত এক রক্তক্ষয়ী যুদ্ধের রূপ নেয়।","size":98,"start":150.6,"length":3.7},{"text":"আর সেই যুদ্ধের সঙ্গে জড়িয়ে আছে একটি\nরহস্যময় কূপের কাহিনী—জীয়ৎকুণ্ড।","size":98,"start":154.3,"length":5.5},{"text":"সেই কাহিনীই আমাদের নিয়ে যাবে\nমহাস্থানগড়ের সবচেয়ে নাটকীয় অধ্যায়ে।","size":98,"start":159.8,"length":4.1}],"font":{"url":"https://raw.githubusercontent.com/Salimtech353/Reels_Factory/main/File/Kolpona_Unicode.ttf","name":"Kolpona","bold":false}},"segments":[{"start":0,"duration":9.6,"media":{"type":"video","file":"m0.mp4"}},{"start":9.6,"duratio