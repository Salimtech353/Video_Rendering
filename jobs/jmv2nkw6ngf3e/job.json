{"version":1,"W":1280,"H":720,"cw":972,"ch":548,"borderColor":"#1A1A1A","total":30,"captions":{"enabled":true,"size":42,"color":"#ffffff","anim":"typewriter","bottomY":623.5,"lines":[{"text":"একটি দুর্গ, যার","start":0,"length":1.622},{"text":"নির্মাণ কখনো শেষ","start":1.622,"length":1.73},{"text":"হয়নি।","start":3.351,"length":0.649},{"text":"সাড়ে ৩০০ বছর পরও লালবাগ","start":4,"length":1.846},{"text":"কেল্লার দেয়ালে লুকিয়ে আছে","start":5.846,"length":2.077},{"text":"সেই অসামাপ্ত ইতিহাসের গল্প।","start":7.923,"length":2.077},{"text":"আজকের এই যাত্রায় আমরা ঘুরে দেখব","start":10,"length":3},{"text":"ঢাকার লালবাগ কেল্লার সেই ইতিহাস,","start":13,"length":3},{"text":"যেখানে প্রতিটি স্থাপনা যেন","start":16,"length":1.926},{"text":"মুঘল আমলের হারিয়ে যাওয়া","start":17.926,"length":1.852},{"text":"একেকটি গল্পের সাক্ষ্য বহন","start":19.778,"length":1.852},{"text":"করছে।","start":21.63,"length":0.37},{"text":"চলুন, ফিরে যাই কয়েক","start":22,"length":1.5},{"text":"শতাব্দী আগের ঢাকায়।","start":23.5,"length":1.5},{"text":"লালবাগ কেল্লার নির্মাণ","start":25,"length":2.683},{"text":"শুরু হয় ১৬৭৮ সালে।","start":27.683,"length":2.317}],"font":{"url":"https://raw.githubusercontent.com/google/fonts/main/ofl/hindsiliguri/HindSiliguri-Regular.ttf","name":"Hind Siliguri","bold":false}},"segments":[{"start":0,"duration":4,"media":{"type":"video","url":"https://videos.pexels.com/video-files/34281971/14523717_640_360_60fps.mp4"}},{"start":4,"duration":6,"media":{"type":"video","url":"https://videos.pexels.com/video-files/35251592/14934047_640_360_60fps.mp4"}},{"start":10,"duration":6,"media":{"type":"video","url":"https://videos.pexels.com/video-files/35251592/14934047_640_360_60fps.mp4"}},{"start":16,"duration":6,"media":{"type":"video","url":"https://videos.pexels.com/video-files/35251592/14934047_640_360_60fps.mp4"}},{"start":22,"duration":3,"media":{"type":"photo","file":"m4.jpg"}},{"start":25,"duration":5,"media":{"type":"photo","url":"https://images.pexels.com/photos/18129595