{"version":2,"transitions":["fade","slideLeft","slideRight","slideUp","zoom","carouselLeft","carouselRight","wipeLeft","wipeRight"],"W":1024,"H":576,"cw":1024,"ch":576,"borderColor":"#1A1A1A","total":121.4,"captions":{"enabled":true,"size":52,"color":"#ffffff","anim":"typewriter","bottomY":560.4,"lines":[{"text":"আপনাকে যদি বলি,","size":52,"start":0,"length":1.6},{"text":"একটি মাত্র গাছ দুই বিঘারও\nবেশি জমি জুড়ে দাঁড়িয়ে আছে?","size":52,"start":1.6,"length":4},{"text":"আপনি কি বিশ্বাস করবেন?","size":52,"start":5.6,"length":1.6},{"text":"হ্যাঁ, অবিশ্বাস্য হলেও সত্যি!","size":52,"start":7.2,"length":2.5},{"text":"ঠাকুরগাঁওয়ে রয়েছে এমনই এক বিশাল\nআমগাছ, যার বয়স ২০০ বছরেরও বেশি।","size":52,"start":9.7,"length":6},{"text":"এই গাছটির নাম সূর্যপুরী আমগাছ।","size":52,"start":15.7,"length":2.6},{"text":"আর এর বিশালত্ব দেখলে আপনার\nচোখও বিশ্বাস করতে চাইবে না!","size":52,"start":18.3,"length":3.8},{"text":"ঠাকুরগাঁও জেলার বালিয়াডাঙ্গী উপজেলার মণ্ডুমালা গ্রামে,\nহরিণমারী এলাকায় দাঁড়িয়ে আছে প্রকৃতির এই বিস্ময়।","size":46,"start":22.1,"length":7.2},{"text":"দূর থেকে দেখলে মনে হবে, যেন\nএকসঙ্গে দাঁড়িয়ে আছে অসংখ্য গাছ।","size":52,"start":29.3,"length":5.3},{"text":"কিন্তু কাছে গেলেই বুঝবেন, পুরো\nবিস্তৃতিটা একটি মাত্র আমগাছের!","size":52,"start":34.6,"length":5.2},{"text":"আরও অবাক করা বিষয় হলো, গাছটির\nউচ্চতা আনুমানিক ৮০ থেকে ৯০ ফুট।","size":52,"start":39.8,"length":5.7},{"text":"এর মূল কাণ্ড থেকে বেরিয়ে এসেছে বিশাল বিশাল উনিশটি মোটা ডাল,\nযেগুলো চারদিকে ছড়িয়ে পড়ে তৈরি করেছে এক অনন্য প্রাকৃতিক ছাউনি।","size":37,"start":45.5,"length":10.4},{"text":"কিছু ডাল এতটাই মোটা এবং বিস্তৃত যে, সেগুলোকে\nদূর থেকে আলাদা গাছের কাণ্ড বলেও মনে হয়।","size":52,"start":55.9,"length":6.2},{"text":"এবার ভাবুন, প্রায় দুই শতাব্দী ধরে এই গাছ কত ঋতুর পরিবর্তন\nদেখেছে, কত প্রজন্মের মানুষের বেড়ে ওঠার সাক্ষী হয়েছে!","size":44,"start":62.1,"length":9},{"text":"তবে এই গাছ শুধু বিশাল\nআকৃতির জন্যই বিখ্যাত নয়।","size":52,"start":71.1,"length":3.3},{"text":"এটি সূর্যপুরী জাতের আমগাছ, আর সূর্যপুরী আম ঠাকুরগাঁও\nঅঞ্চলের একটি পরিচিত ও জনপ্রিয় আমের জাত।","size":45,"start":74.4,"length":7.2},{"text":"এই আমের সুস্বাদু শাঁস, মনমাতানো সুগন্ধ এবং\nতুলনামূলক ছোট আঁটি এর বিশেষ বৈশিষ্ট্য।","size":52,"start":81.6,"length":7},{"text":"একবার কল্পনা করুন, প্রকৃতির হাতে তৈরি এই বিশাল সবুজ ছাউনির নিচে দাঁড়িয়ে আছেন\nআপনি, আর আপনার মাথার ওপর ছড়িয়ে রয়েছে শত শত ডালপালার এক জীবন্ত সাম্রাজ্য!","size":29,"start":88.6,"length":11.6},{"text":"তাই ঠাকুরগাঁওয়ের এই সূর্যপুরী আমগাছ শুধু একটি গাছ নয়,\nএটি বাংলার গ্রামীণ প্রকৃতি ও ঐতিহ্যের এক অসাধারণ নিদর্শন।","size":43,"start":100.2,"length":8.6},{"text":"একটি গাছ, দুই বিঘারও বেশি বিস্তৃতি, আর প্রায় দুই শতাব্দীর ইতিহাস। এমন বিস্ময়\nনিজের চোখে দেখতে চাইলে সূর্যপুরী আমগাছ হতে পারে আপনার পরবর্তী ভ্রমণের গন্তব্য।","size":31,"start":108.8,"length":12.6}],"font":{"url":"https://raw.githubusercontent.com/google/fonts/main/ofl/hindsiliguri/HindSiliguri-Regular.ttf","name":"Hind Siliguri","bold":false}},"segments":[{"start":0,"duration":1.6,"media":{"type":"video","url":"https://videos.pexels.com/video-files/37522860/15897823_640_360_60fps.mp4"}},{"start":1.6,"duration":3.9999999999999996,"media":{"type":"video","url":"https://videos.pexels.com/video-files/31369206/13385950_640_360_60fps.mp4"}},{"start":5.6,"duration":1.6000000000000005,"media":{"type":"video","url":"https://videos.pexels.com/video-files/6287183/6287183-sd_640_360_25fps.mp4"}},{"start":7.2,"duration":2.499999999999999,"media":{"type":"video","url":"https://videos.pexels.com/video-files/2239153/2239153-sd_640_360_24fps.mp4"}},{"start":9.7,"duration":6,"media":{"type":"video","url":"https://videos.pexels.com/video-files/34515139/14623869_640_360_30fps.mp4"}},{"start":15.7,"duration":2.6000000000000014,"media":{"type":"photo","url":"https://images.pexels.com/photos/7529893/pexels-photo-7529893.jpeg?auto=compress&cs=tinysrgb&h=650&w=940"}},{"start":18.3,"duration":3.8000000000000007,"media":{"type":"video","url":"https://videos.pexels.com/video-files/34937690/14800553_640_360_25fps.mp4"}},{"start":22.1,"duration":7.199999999999999,"media":{"type":"video","url":"https://videos.pexels.com/video-files/35337288/14972345_640_360_30fps.mp4"}},{"start":29.3,"duration":5.300000000000001,"media":{"type":"video","url":"https://videos.pexels.com/video-files/32212948/13738821_640_360_60fps.mp4"}},{"start":34.6,"duration":5.199999999999996,"media":{"type":"video","url":"https://videos.pexels.com/video-files/4170776/4170776-sd_640_360_24fps.mp4"}},{"start":39.8,"duration":5.700000000000003,"media":{"type":"video","url":"https://videos.pexels.com/video-files/34515139/14623869_640_360_30fps.mp4"}},{"start":45.5,"duration":10.399999999999999,"media":{"type":"video","url":"https://videos.pexels.com/video-files/34937690/14800553_640_360_25fps.mp4"}},{"start":55.9,"duration":6.200000000000003,"media":{"type":"video","url":"https://videos.pexels.com/video-files/31584453/13459626_640_360_30fps.mp4"}},{"start":62.1,"duration":8.999999999999993,"media":{"type":"video","url":"https://videos.pexels.com/video-files/11760142/11760142-sd_640_338_30fps.mp4"}},{"start":71.1,"duration":3.3000000000000114,"media":{"type":"video","url":"https://videos.pexels.com/video-files/2239153/2239153-sd_640_360_24fps.mp4"}},{"start":74.4,"duration":7.199999999999989,"media":{"type":"photo","url":"https://images.pexels.com/photos/9219974/pexels-photo-9219974.jpeg?auto=compress&cs=tinysrgb&h=650&w=940"}},{"start":81.6,"duration":7,"media":{"type":"photo","url":"https://images.pexels.com/photos/16724967/pexels-photo-16724967.jpeg?auto=compress&cs=tinysrgb&h=650&w=940"}},{"start":88.6,"duration":11.600000000000009,"media":{"type":"video","url":"https://videos.pexels.com/video-files/34937690/14800553_640_360_25fps.mp4"}},{"start":100.2,"duration":8.599999999999994,"media":{"type":"photo","file":"m18.jpg"}},{"start":108.8,"duration":12.600000000000009,"media":{"type":"video","url":"https://videos.pexels.com/video-files/2239153/2239153-sd_640_360_24fps.mp4"}}],"audio":{"file":"audi