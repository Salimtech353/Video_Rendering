{"version":2,"transitions":["fade","slideLeft","slideRight","slideUp","zoom","carouselLeft","carouselRight","wipeLeft","wipeRight"],"W":1920,"H":1080,"cw":1920,"ch":1080,"borderColor":"#1A1A1A","total":244,"captions":{"enabled":true,"size":120,"color":"#ffffff","anim":"slideUp","bottomY":1044,"lines":[{"text":"বাংলাদেশের বুকেই রয়েছে এমন একটি শহর,\nযেখানে একসময় বসবাস করতেন ধনী ব্যবসায়ীরা।","size":120,"start":0,"length":5.6},{"text":"ছিল জমজমাট বাণিজ্য, বিলাসবহুল\nবাড়ি আর মানুষের ব্যস্ত পদচারণা।","size":120,"start":5.6,"length":5.2},{"text":"কিন্তু আজ সেই শহরের রাস্তায়\nনেই কোনো স্থায়ী বাসিন্দা।","size":120,"start":10.8,"length":4.3},{"text":"দুই পাশে দাঁড়িয়ে থাকা শতবর্ষী বাড়িগুলো যেন\nনীরবে বলে যায় এক হারিয়ে যাওয়া সময়ের গল্প।","size":120,"start":15.1,"length":6.2},{"text":"কেন জনশূন্য হলো এই শহর?\nকোথায় চলে গেল এখানকার মানুষ?","size":120,"start":21.3,"length":2.1},{"text":"আজকের গল্প বাংলাদেশের\nঐতিহাসিক পানাম নগরকে নিয়ে।","size":120,"start":23.4,"length":2.3},{"text":"এই চ্যানেলে যারা নতুন অনুগ্রহ করে\nচ্যানেলটি সাবস্ক্রাইব করে পাশে থাকবেন।","size":120,"start":25.7,"length":8},{"text":"পানাম নগর অবস্থিত\nনারায়ণগঞ্জ জেলার সোনারগাঁয়ে।","size":120,"start":33.7,"length":3.5},{"text":"সোনারগাঁ একসময় ছিল বাংলার অন্যতম\nগুরুত্বপূর্ণ রাজনৈতিক ও বাণিজ্যিক কেন্দ্র।","size":120,"start":37.2,"length":5.3},{"text":"মধ্যযুগের সুলতানি আমলে এটি বাংলার\nঅন্যতম রাজধানী হিসেবে পরিচিতি লাভ করে।","size":120,"start":42.5,"length":5.2},{"text":"পরবর্তীতে বারো ভূঁইয়াদের নেতা ঈশা খাঁ র\nইতিহাসের সঙ্গেও এই অঞ্চল জড়িয়ে যায়।","size":120,"start":47.7,"length":5.6},{"text":"মুঘল আমলে বাংলার রাজধানী ঢাকায় স্থানান্তরিত\nহওয়ার পর সোনারগাঁয়ের রাজনৈতিক গুরুত্ব কমে যায়।","size":114,"start":53.3,"length":6.4},{"text":"তবে বাণিজ্যিক গুরুত্ব পুরোপুরি হারায়নি।","size":120,"start":59.7,"length":2.7},{"text":"বিশেষ করে ব্রিটিশ শাসনামলে এই অঞ্চলে\nবস্ত্র ব্যবসা ও তাঁত শিল্পের প্রসার ঘটে।","size":120,"start":62.4,"length":5.7},{"text":"সেই বাণিজ্যিক সমৃদ্ধির ধারাবাহিকতায় ১৯ শতকে\nগড়ে ওঠে পানাম নগরের বর্তমান পরিচিত জনপদ।","size":120,"start":68.1,"length":6.6},{"text":"পানাম নগরের প্রধান বাসিন্দা ছিলেন ধনী হিন্দু ব্যবসায়ী পরিবারগুলো, বিশেষ\nকরে সাহা ও পোদ্দার সম্প্রদায়ের ব্যবসায়ীরা এখানে বসতি গড়ে তোলেন।","size":83,"start":74.7,"length":8.9},{"text":"তাদের ব্যবসার অন্যতম ক্ষেত্র ছিল\nসুতি কাপড় ও অন্যান্য বস্ত্রের বাণিজ্য।","size":120,"start":83.6,"length":5},{"text":"ব্যবসায়িক সাফল্যের কারণে তারা\nনির্মাণ করেন দৃষ্টিনন্দন আবাসিক ভবন।","size":120,"start":88.6,"length":4.5},{"text":"বাড়িগুলোতে ছিল প্রশস্ত কক্ষ, কারুকার্যখচিত\nবারান্দা, খিলান, স্তম্ভ এবং নান্দনিক দরজা-জানালা।","size":120,"start":93.1,"length":7.2},{"text":"এখানে ইউরোপীয় ঔপনিবেশিক স্থাপত্যের পাশাপাশি মুঘল ও স্থানীয় বাংলার স্থাপত্যরীতির প্রভাব দেখা যায়। আজও পানাম\nনগরের সরু রাস্তার দুই পাশে দাঁড়িয়ে থাকা পুরোনো ভবনগুলো সেই সময়ের ব্যবসায়িক সমৃদ্ধি ও আভিজাত্যের সাক্ষ্য বহন করছে।","size":48,"start":100.3,"length":15.3},{"text":"কিন্তু প্রশ্ন হলো, কেন জনশূন্য\nহয়ে গেল এই সমৃদ্ধ শহর?","size":120,"start":115.6,"length":4.6},{"text":"এর পেছনে রয়েছে ভারতীয় উপমহাদেশের\nরাজনৈতিক ইতিহাসের কয়েকটি গুরুত্বপূর্ণ ঘটনা।","size":120,"start":120.2,"length":5.3},{"text":"১৯৪৭ সালে ব্রিটিশ শাসনের অবসানের পর ভারতবর্ষ\nবিভক্ত হয়ে ভারত ও পাকিস্তান নামে দুটি রাষ্ট্রের জন্ম হয়।","size":106,"start":125.5,"length":7.9},{"text":"বর্তমান বাংলাদেশের ভূখণ্ড তখন\nপূর্ব পাকিস্তান নামে পরিচিত ছিল।","size":120,"start":133.4,"length":4.6},{"text":"দেশভাগের পর বিভিন্ন অঞ্চলে সাম্প্রদায়িক\nউত্তেজনা ও নিরাপত্তাহীনতা তৈরি হয়।","size":120,"start":138,"length":5.2},{"text":"পানাম নগরের অধিকাংশ বাসিন্দা\nছিলেন হিন্দু ব্যবসায়ী পরিবার।","size":120,"start":143.2,"length":4.1},{"text":"রাজনৈতিক পরিবর্তন ও অনিশ্চয়তার কারণে অনেক\nপরিবার ধীরে ধীরে ভারতে চলে যেতে শুরু করে।","size":119,"start":147.3,"length":5.8},{"text":"১৯৬৪ সালের সাম্প্রদায়িক দাঙ্গা এবং ১৯৬৫ সালের\nভারত-পাকিস্তান যুদ্ধের পর পরিস্থিতি আরো জটিল হয়ে ওঠে।","size":101,"start":153.1,"length":7.9},{"text":"ফলে অবশিষ্ট অনেক পরিবারও\nপানাম নগর ছেড়ে ভারতে চলে যায়।","size":120,"start":161,"length":4.1},{"text":"একসময় যে শহর ছিল ব্যবসা ও মানুষের পদচারণায়\nমুখর, সেটি ধীরে ধীরে পরিণত হয় জনশূন্য এক নগরীতে।","size":111,"start":165.1,"length":7.8},{"text":"পরিত্যক্ত বাড়িগুলো পরবর্তীতে তৎকালীন\nসরকারের শত্রু সম্পত্তি হিসেবে চিহ্নিত হয়।","size":120,"start":172.9,"length":5.4},{"text":"অর্থাৎ পানাম নগর কোনো একদিনে ধ্বংস হয়নি।","size":120,"start":178.3,"length":3},{"text":"দেশভাগ, রাজনৈতিক অস্থিরতা, সাম্প্রদায়িক পরিস্থিতি এবং মানুষের\nদেশত্যাগ সব মিলিয়েই এই নগরের স্বাভাবিক জীবন থেমে যায়।","size":90,"start":181.3,"length":9.2},{"text":"বর্তমানে পানাম নগর বাংলাদেশের\nঅন্যতম গুরুত্বপূর্ণ প্রত্নতাত্ত্বিক ঐতিহ্য।","size":120,"start":190.5,"length":4.7},{"text":"এখানে প্রত্নতত্ত্ব অধিদপ্তরের নথিভুক্ত\n৫২টি ঐতিহাসিক স্থাপনা রয়েছে।","size":120,"start":195.2,"length":4.7},{"text":"নগরের কাছেই রয়েছে ঐতিহাসিক পানাম সেতু, গোয়ালদি\nমসজিদ এবং সোনারগাঁয়ের অন্যান্য প্রত্নতাত্ত্বিক নিদর্শন।","size":110,"start":199.9,"length":7.3},{"text":"২০০৬ সালে ওয়ার্ল্ড মনুমেন্টস ফান্ড পানাম নগরকে বিশ্বের\n১০০টি বিপন্ন ঐতিহাসিক স্থাপনার তালিকায় অন্তর্ভুক্ত করে।","size":101,"start":207.2,"length":7.7},{"text":"সময়, আবহাওয়া এবং দীর্ঘদিনের অবহেলায় অনেক ভবন ক্ষতিগ্রস্ত হয়েছে।\nতাই এই ঐতিহাসিক স্থাপনাগুলো সংরক্ষণ করা এখন অত্যন্ত গুরুত্বপূর্ণ।","size":82,"start":214.9,"length":10.3},{"text":"আজ পানাম নগরের রাস্তায় হাঁটলে হয়তো মানুষের কোলাহল শোনা যায় না, কিন্তু\nপ্রতিটি পুরোনো বাড়ি আমাদের মনে করিয়ে দেয় একটি সমৃদ্ধ অতীতের কথা।","size":78,"start":225.2,"length":8.6},{"text":"পানাম নগর শুধুই একটি পরিত্যক্ত শহর নয়,","size":120,"start":233.8,"length":2.9},{"text":"এটি বাংলার ব্যবসা, বাণিজ্য, স্থাপত্য, দেশভাগ এবং\nমানুষের হারিয়ে যাওয়া জীবনের এক জীবন্ত ইতিহাস।","size":119,"start":236.7,"length":7.3}],"font":{"url":"https://raw.githubusercontent.com/Salimtech353/Reels_Factory/main/File/Kolpona_Unicode.ttf","name":"Kolpona","bold":false}},"segments":[{"start":0,"duration":5.6,"media":{"type":"video","url":"https://videos.pexels.com/video-f